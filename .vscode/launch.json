{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Physics Engine",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/test/main.exe",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
